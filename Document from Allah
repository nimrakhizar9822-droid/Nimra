        "        labeled, binary, thresh = otsu_segment(gray)\n",
        "        df = feature_table(labeled, gray.astype(float)/255.0)\n",
        "        summary = table_to_summary(df, image_id)\n",
        "        if image_id == \"test_004\":\n",
        "            example_summary = summary\n",

        "    union = preds_f.sum(1) + targets_f.sum(1)\n",
        "    dice = (2*inter + eps) / (union + eps)\n",
        "    iou = (inter + eps) / (union - inter + eps)\n",
        "    return dice.mean().item(), iou.mean().item()\n",
